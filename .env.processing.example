# Environment for docker-compose.processing.yml  (docs/PROCESSING_DEPLOYMENT.md)
#
# Copy to `.env.processing` (untracked) and fill in. EVERY VALUE BELOW IS A PLACEHOLDER. Never commit the real file.
# Pass it with:  docker compose -f docker-compose.processing.yml --env-file .env.processing up -d

# --- Required -----------------------------------------------------------------

# The clinical database both workers write to (a role that may use the clinical schema; NOT an administrative one).
# CLINICAL_DSN=postgresql://clinical_app:CHANGE_ME@db-host:5432/clinical
CLINICAL_DSN=

# Each entry binds one API key to ONE clinical organisation: key:organisation-uuid, comma separated. A bare key, a key
# bound to two organisations, or a non-UUID refuses to start the API. Generate keys with a password manager or
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
# GEPER_API_KEYS=CHANGE_ME_key_one:00000000-0000-0000-0000-000000000000
GEPER_API_KEYS=

# Origins allowed to call the API from a browser.
# GEPER_CORS_ORIGINS=https://your-frontend.example.com
GEPER_CORS_ORIGINS=

# The host directory holding one sub-directory per organisation, named by the organisation's UUID:
#   <GEPER_VCF_HOST_DIR>/<organisation UUID>/<file>.vcf  (or .vcf.gz)
# Mounted read-only at /data/vcf (= GEPER_VCF_ROOT inside the containers). Only the platform may write here; it must be
# readable by the container user and not world-writable (the services refuse to start otherwise).
GEPER_VCF_HOST_DIR=

# --- Optional -----------------------------------------------------------------

# GEPER_IMAGE=geper:latest
# GEPER_API_PORT=8100
# EXCEPTION_RETRY_POLL_INTERVAL=30

# Engine settings, passed to the submission worker (see .env.example for what each does).
# BIJ_AI_CLI_PATH=/app/geper/main.py
# BLAST policy. Compose sets GEPER_AI_ONLY=true by default (BLAST disabled; the DNA/RNA/protein models and the evidence
# databases still run). Set it to 0, false, no or off to let the engine use BLAST (a local database, else remote NCBI,
# which can take very long; see docs/PROCESSING_DEPLOYMENT.md). Any other value, even an unexpected one, means AI-only.
# GEPER_AI_ONLY=true
# GEPER_NCBI_EMAIL=
# GEPER_NCBI_API_KEY=
# GEPER_BLAST_DATABASE=
# GEPER_ALPHAMISSENSE_HG38_LOCAL=
# GEPER_ALPHAMISSENSE_HG19_LOCAL=
